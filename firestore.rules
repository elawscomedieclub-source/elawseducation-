rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/profile/{profileId} {
      allow read: if isOwner(userId) && profileId == 'main';

      allow create, update: if isOwner(userId)
        && profileId == 'main'
        && request.resource.data.keys().hasOnly([
          'level', 'track', 'series', 'name', 'photoBase64', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && (!('name' in request.resource.data)
          || (request.resource.data.name is string
            && request.resource.data.name.size() <= 100))
        && (!('photoBase64' in request.resource.data)
          || (request.resource.data.photoBase64 is string
            && request.resource.data.photoBase64.size() <= 350000))
        && (!('level' in request.resource.data)
          || request.resource.data.level is string)
        && (!('track' in request.resource.data)
          || request.resource.data.track is string)
        && (!('series' in request.resource.data)
          || request.resource.data.series is string);

      allow delete: if isOwner(userId) && profileId == 'main';
    }

    match /users/{userId}/progress/{progressId} {
      allow read: if isOwner(userId) && progressId == 'main';

      allow create, update: if isOwner(userId)
        && progressId == 'main'
        && request.resource.data.keys().hasAll([
          'answeredExerciseIds',
          'correctExerciseIds',
          'xp',
          'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'answeredExerciseIds',
          'correctExerciseIds',
          'xp',
          'updatedAt'
        ])
        && request.resource.data.answeredExerciseIds is list
        && request.resource.data.answeredExerciseIds.size() <= 5000
        && request.resource.data.correctExerciseIds is list
        && request.resource.data.correctExerciseIds.size() <= 5000
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isOwner(userId) && progressId == 'main';
    }

    match /users/{userId}/evaluations/{evaluationId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'subjectId',
          'subjectName',
          'level',
          'score',
          'correct',
          'total',
          'date'
        ])
        && request.resource.data.keys().hasOnly([
          'subjectId',
          'subjectName',
          'level',
          'score',
          'correct',
          'total',
          'date'
        ])
        && request.resource.data.subjectId is string
        && request.resource.data.subjectName is string
        && request.resource.data.level is string
        && request.resource.data.subjectId.size() <= 160
        && request.resource.data.subjectName.size() <= 160
        && request.resource.data.level.size() <= 40
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 20
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 100
        && request.resource.data.correct <= request.resource.data.total
        && request.resource.data.date is string
        && request.resource.data.date.size() <= 50;

      allow delete: if isOwner(userId);
    }
  }
}